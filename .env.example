# Gemini (free tier) — crie a chave no Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Bluesky — use App Password (Settings > App Passwords), nunca a senha principal
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Nominatim exige User-Agent identificável (nome do app + contato)
NOMINATIM_USER_AGENT=polari/0.1 (seu-email@exemplo.com)

# Privacidade: células com menos itens que isso são ocultadas no mapa
MIN_CELL_SIZE=3

# Segredo do projeto: deriva o hash dos IDs e a chave que criptografa o link original.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Guarde um backup fora do repositório: perder ou trocar este valor quebra a deduplicação.
POLARI_SECRET_KEY=

# Hugging Face: dataset PRIVADO com o texto bruto (docs/decisions/armazenamento-bruto.md).
# Token fine-grained com escrita só nesse repositório.
HF_TOKEN=
HF_RAW_REPO=seu-usuario/polari-raw
OPENAI_API_KEY=
OPENAI_MODEL=
