# Gemini (free tier) — crie a chave no Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Bluesky — use App Password (Settings > App Passwords), nunca a senha principal
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Nominatim exige User-Agent identificável (nome do app + contato)
NOMINATIM_USER_AGENT=polari/0.1 (seu-email@exemplo.com)

# Privacidade: células com menos itens que isso são ocultadas no mapa
MIN_CELL_SIZE=3
